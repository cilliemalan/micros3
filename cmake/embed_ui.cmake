# Writes the web UI's embedded file table (docs/UI.md, "Build and embedding").
#
#   cmake -DDIST=<build>/ui/dist -DOUTPUT=<build>/ui/ui_assets.cpp -P embed_ui.cmake
#
# Every file under DIST, in sorted order, becomes one ui::Asset entry with its
# path (from DIST, with a leading /), content type, bytes and size. The result
# is written to a temporary file and copied over OUTPUT only when it differs,
# so the library is not recompiled when the UI build gave the same bytes.

if(NOT DEFINED DIST OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "embed_ui.cmake needs -DDIST=<dir> and -DOUTPUT=<file>")
endif()
if(NOT IS_DIRECTORY "${DIST}" OR NOT EXISTS "${DIST}/index.html")
    message(FATAL_ERROR "embed_ui.cmake: ${DIST}/index.html does not exist; the UI build did not run")
endif()

function(content_type path out)
    string(REGEX MATCH "\\.[^./]*$" ext "${path}")
    string(TOLOWER "${ext}" ext)
    # Not a list: the types hold semicolons.
    if(ext STREQUAL ".html")
        set(type "text/html; charset=utf-8")
    elseif(ext STREQUAL ".js" OR ext STREQUAL ".mjs")
        set(type "text/javascript; charset=utf-8")
    elseif(ext STREQUAL ".css")
        set(type "text/css; charset=utf-8")
    elseif(ext STREQUAL ".txt")
        set(type "text/plain; charset=utf-8")
    elseif(ext STREQUAL ".json" OR ext STREQUAL ".map")
        set(type "application/json")
    elseif(ext STREQUAL ".svg")
        set(type "image/svg+xml")
    elseif(ext STREQUAL ".png")
        set(type "image/png")
    elseif(ext STREQUAL ".jpg" OR ext STREQUAL ".jpeg")
        set(type "image/jpeg")
    elseif(ext STREQUAL ".gif")
        set(type "image/gif")
    elseif(ext STREQUAL ".webp")
        set(type "image/webp")
    elseif(ext STREQUAL ".ico")
        set(type "image/x-icon")
    elseif(ext STREQUAL ".woff")
        set(type "font/woff")
    elseif(ext STREQUAL ".woff2")
        set(type "font/woff2")
    elseif(ext STREQUAL ".wasm")
        set(type "application/wasm")
    else()
        set(type "application/octet-stream")
    endif()
    set(${out} "${type}" PARENT_SCOPE)
endfunction()

# A C++ string literal for `text`, which holds only path and type characters.
function(cxx_literal text out)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE files RELATIVE "${DIST}" LIST_DIRECTORIES false "${DIST}/*")
list(SORT files)

set(arrays "")
set(entries "")
set(index 0)
foreach(file IN LISTS files)
    file(SIZE "${DIST}/${file}" size)
    content_type("${file}" type)
    cxx_literal("/${file}" path_literal)
    cxx_literal("${type}" type_literal)
    if(size EQUAL 0)
        set(data_name "nullptr")
    else()
        file(READ "${DIST}/${file}" hex HEX)
        # 0x.. for each byte, with a line break every 32 bytes.
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
        string(REPEAT "0x..," 32 row)
        string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
        set(data_name "asset_${index}")
        string(APPEND arrays "// ${file}\nconst unsigned char ${data_name}[] = {\n${hex}\n};\n\n")
    endif()
    string(APPEND entries "    {${path_literal}, ${type_literal}, ${data_name}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by cmake/embed_ui.cmake from the UI build. Do not edit.

#include \"micros3/ui_assets.h\"

namespace micros3::ui {

namespace {

${arrays}const Asset kAssets[] = {
${entries}};

} // namespace

Assets embedded_assets() { return {kAssets, sizeof(kAssets) / sizeof(kAssets[0])}; }

} // namespace micros3::ui
")

file(WRITE "${OUTPUT}.tmp" "${content}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" RESULT_VARIABLE copied)
file(REMOVE "${OUTPUT}.tmp")
if(NOT copied EQUAL 0)
    message(FATAL_ERROR "embed_ui.cmake: could not write ${OUTPUT}")
endif()
